# Copy to .env and fill in. NEVER commit .env.

# ── Database ─────────────────────────────────────────────────────────────────
# Local development: one URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shree_guruji_crm_dev
# Deployment alternative (used instead of DATABASE_URL when DB_HOST is set):
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=true

# ── Server ───────────────────────────────────────────────────────────────────
# https:// turns on the Secure __Host-session cookie; http:// (local) uses a plain cookie.
APP_ORIGIN=http://localhost:3000

# ── Demo only ────────────────────────────────────────────────────────────────
# Lists the seeded personas on the login page and lets them sign in without a password.
# Honoured only when the database name ends in _dev or _demo. NEVER on a client deployment.
DEMO_LOGINS=true
# Password given to the seeded demo users by `npm run db:seed` (dev/demo databases only). Choose one, 8+ chars.
DEMO_PASSWORD=

# ── Inbound lead capture (website form / Phase 2 WhatsApp bot) ──────────────
# Shared secret a caller sends as `Authorization: Bearer <token>` to POST /api/inbound/leads.
# UNSET MEANS CLOSED (403).
# INBOUND_TOKEN=
